{
  "name": "vinaru-browser",
  "productName": "Vinaru",
  "version": "1.0.0",
  "description": "Vinaru desktop browser",
  "private": true,
  "author": "Vinaru",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/generate-icon.js && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-ico.ps1",
    "dist": "npm run icons && electron-builder",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-ico.ps1 && electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.vinaru.browser",
    "productName": "Vinaru",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "vpn/**/*",
      "google-oauth.json",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "vinaru-setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "category": "Network",
      "artifactName": "vinaru-${version}-linux.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "vinaru-${version}.${ext}"
    }
  }
}
